// Windows resource script for SteamIdle.
// The first icon in the file becomes the executable icon shown in Explorer.

IDI_STEAMIDLE ICON "steamidle.ico"

1 VERSIONINFO
FILEVERSION 0, 1, 0, 0
PRODUCTVERSION 0, 1, 0, 0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SteamIdle contributors"
            VALUE "FileDescription", "SteamIdle - Steam session companion"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "SteamIdle"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "steamidle.exe"
            VALUE "ProductName", "SteamIdle"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
